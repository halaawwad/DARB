generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  legalName   String?
  timezone    String   @default("Asia/Gaza")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  users       User[]
  roles       Role[]
  permissions Permission[]
  customers   Customer[]
  customerAssignments CustomerAssignment[]
  customerVisits CustomerVisit[]
  products    Product[]
  orders      SalesOrder[]
  checkpoints Checkpoint[]
  incidents   RoadIncident[]
  notifications Notification[]
  auditLogs   AuditLog[]
  syncOps     SyncOperation[]

  @@map("companies")
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  companyId String?          @db.Uuid
  key       String
  description String?
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  company   Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([companyId, key])
  @@map("permissions")
}

model Role {
  id        String           @id @default(uuid()) @db.Uuid
  companyId String           @db.Uuid
  name      String
  description String?
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles UserRole[]

  @@unique([companyId, name])
  @@map("roles")
}

model RolePermission {
  id          String      @id @default(uuid()) @db.Uuid
  roleId      String      @db.Uuid
  permissionId String     @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission  Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @db.Uuid
  firstName     String
  lastName      String
  email         String
  passwordHash  String
  phone         String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userRoles     UserRole[]
  salesOrders   SalesOrder[]  @relation("SalesOrderRep")
  assignments   CustomerAssignment[]
  visits        CustomerVisit[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@unique([companyId, email])
  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Customer {
  id                 String                @id @default(uuid()) @db.Uuid
  companyId          String                @db.Uuid
  name               String
  shopName           String
  phone              String?
  area               String?
  address            String?
  latitude           Decimal               @db.Decimal(9, 6)
  longitude          Decimal               @db.Decimal(9, 6)
  isActive           Boolean               @default(true)
  preferredVisitTime String?
  balance            Decimal               @default(0) @db.Decimal(18, 2)
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(6)
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments        CustomerAssignment[]
  visits             CustomerVisit[]
  orders             SalesOrder[]
  preferences        CustomerPreference[]

  @@index([companyId])
  @@map("customers")
}

model CustomerAssignment {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  salespersonId String @db.Uuid
  companyId   String   @db.Uuid
  assignedAt  DateTime @default(now()) @db.Timestamptz(6)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesperson User     @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([customerId, salespersonId])
  @@map("customer_assignments")
}

model CustomerVisit {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  userId      String   @db.Uuid
  companyId   String   @db.Uuid
  visitedAt   DateTime @default(now()) @db.Timestamptz(6)
  notes       String?
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([customerId, visitedAt])
  @@map("customer_visits")
}

model CustomerPreference {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  key         String
  value       String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, key])
  @@map("customer_preferences")
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @db.Uuid
  name        String
  sku         String
  unit        String
  price       Decimal          @db.Decimal(18, 2)
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prices      ProductPrice[]
  inventory   Inventory[]
  orderItems  OrderItem[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@map("products")
}

model ProductPrice {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  price       Decimal  @db.Decimal(18, 2)
  validFrom   DateTime @default(now()) @db.Timestamptz(6)
  validTo     DateTime?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_prices")
}

model Inventory {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @db.Uuid
  warehouse   String?
  quantity    Decimal   @db.Decimal(18, 3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouse])
  @@map("inventory")
}

model SalesOrder {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String             @db.Uuid
  customerId        String             @db.Uuid
  repId             String             @db.Uuid
  orderNumber       String             @unique
  status            String             @default("pending")
  source            String             @default("manual")
  total             Decimal            @db.Decimal(18, 2)
  notes             String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rep               User               @relation("SalesOrderRep", fields: [repId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  deliveryTasks     DeliveryTask[]
  invoices          Invoice[]

  @@index([companyId, status])
  @@map("sales_orders")
}

model OrderItem {
  id           String      @id @default(uuid()) @db.Uuid
  orderId      String      @db.Uuid
  productId    String      @db.Uuid
  quantity     Decimal     @db.Decimal(18, 3)
  unitPrice    Decimal     @db.Decimal(18, 2)
  lineTotal    Decimal     @db.Decimal(18, 2)
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)
  order        SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model OrderStatusHistory {
  id          String     @id @default(uuid()) @db.Uuid
  orderId     String     @db.Uuid
  status      String
  changedById String?    @db.Uuid
  changedAt   DateTime   @default(now()) @db.Timestamptz(6)
  note        String?
  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

model Vehicle {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @db.Uuid
  plateNumber   String
  label         String?
  capacityKg    Decimal?      @db.Decimal(18, 2)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  deliveryTasks DeliveryTask[]

  @@unique([companyId, plateNumber])
  @@map("vehicles")
}

model Route {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  name        String
  status      String       @default("planned")
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  routeStops  RouteStop[]

  @@map("routes")
}

model RouteStop {
  id          String       @id @default(uuid()) @db.Uuid
  routeId     String       @db.Uuid
  customerId  String?      @db.Uuid
  stopLabel   String?
  sequence    Int
  eta         DateTime?
  route       Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  deliveryTask DeliveryTask? @relation(fields: [deliveryTaskId], references: [id])
  deliveryTaskId String? @db.Uuid

  @@map("route_stops")
}

model DeliveryTask {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @db.Uuid
  orderId       String       @db.Uuid
  vehicleId     String?      @db.Uuid
  assigneeId    String?      @db.Uuid
  status        String       @default("assigned")
  priority      String       @default("normal")
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)
  order         SalesOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  routeStops    RouteStop[]

  @@map("delivery_tasks")
}

model Checkpoint {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  name        String
  latitude    Decimal       @db.Decimal(9, 6)
  longitude   Decimal       @db.Decimal(9, 6)
  status      String        @default("open")
  updatedAt   DateTime      @default(now()) @db.Timestamptz(6)
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roadIncidents RoadIncident[]

  @@index([companyId])
  @@map("checkpoints")
  @@unique([companyId, id], map: "checkpoints_company_id_key")
}

model RoadSegment {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  name        String
  fromLat     Decimal  @db.Decimal(9, 6)
  fromLng     Decimal  @db.Decimal(9, 6)
  toLat       Decimal  @db.Decimal(9, 6)
  toLng       Decimal  @db.Decimal(9, 6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@map("road_segments")
}

model RoadIncident {
  id              String      @id @default(uuid()) @db.Uuid
  companyId       String      @db.Uuid
  checkpointId    String?     @db.Uuid
  incidentType    String
  description     String
  latitude        Decimal     @db.Decimal(9, 6)
  longitude       Decimal     @db.Decimal(9, 6)
  severity        String      @default("medium")
  status          String      @default("open")
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(6)
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  checkpoint      Checkpoint? @relation(fields: [companyId, checkpointId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction, map: "road_incidents_company_checkpoint_fk")
  confirmations   IncidentConfirmation[]

  @@index([companyId, status])
  @@map("road_incidents")
}

model IncidentConfirmation {
  id          String       @id @default(uuid()) @db.Uuid
  incidentId  String       @db.Uuid
  userId      String       @db.Uuid
  confirmedAt DateTime     @default(now()) @db.Timestamptz(6)
  note        String?
  incident    RoadIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@map("incident_confirmations")
}

model Invoice {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @db.Uuid
  orderId     String      @db.Uuid
  invoiceNumber String     @unique
  total       Decimal     @db.Decimal(18, 2)
  status      String      @default("issued")
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  order       SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Payment {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  customerId  String    @db.Uuid
  amount      Decimal   @db.Decimal(18, 2)
  method      String
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@map("payments")
}

model Collection {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  customerId  String    @db.Uuid
  amount      Decimal   @db.Decimal(18, 2)
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@map("collections")
}

model CheckRecord {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  customerId  String    @db.Uuid
  checkNumber String    @unique
  amount      Decimal   @db.Decimal(18, 2)
  status      String    @default("issued")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@map("checks")
}

model Wallet {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  customerId  String   @db.Uuid
  balance     Decimal  @default(0) @db.Decimal(18, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  walletId    String   @db.Uuid
  amount      Decimal  @db.Decimal(18, 2)
  direction   String
  note        String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@map("wallet_transactions")
}

model Return {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  orderId     String   @db.Uuid
  amount      Decimal  @db.Decimal(18, 2)
  reason      String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@map("returns")
}

model FinancialTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  kind        String
  amount      Decimal  @db.Decimal(18, 2)
  reference   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@map("financial_transactions")
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  userId      String?   @db.Uuid
  title       String
  body        String
  channel     String    @default("in_app")
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, isRead])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  userId      String?  @db.Uuid
  entityType  String
  entityId    String
  action      String
  payload     Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model SyncOperation {
  id            String           @id @default(uuid()) @db.Uuid
  companyId     String           @db.Uuid
  userId        String?          @db.Uuid
  operationType String
  status        String           @default("queued")
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items         SyncOperationItem[]

  @@map("sync_operations")
}

model SyncOperationItem {
  id             String         @id @default(uuid()) @db.Uuid
  syncOperationId String        @db.Uuid
  entityType     String
  entityId       String
  requestHash    String?
  idempotencyKey String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  syncOperation  SyncOperation  @relation(fields: [syncOperationId], references: [id], onDelete: Cascade)

  @@map("sync_operation_items")
}

model AiTranscript {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  userId      String?   @db.Uuid
  sourceType  String
  sourceId    String?
  language    String    @default("ar")
  transcript  String
  metadata    Json?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@map("ai_transcripts")
}

model AiAnalysis {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  sourceType  String
  sourceId    String
  intent      String?
  summary     String?
  confidence  Decimal?  @db.Decimal(5, 2)
  metadata    Json?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@map("ai_analyses")
}
