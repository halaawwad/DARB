PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# For a backend run directly on Windows against the DARB Docker services.
# Compose instead uses the root .env and internal postgres:5432 / redis:6379.
DATABASE_URL=postgresql://darb:replace_with_root_env_password@127.0.0.1:5434/darb?schema=public
REDIS_URL=redis://127.0.0.1:6380
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Expo Go on a physical phone connects via your LAN IP, not localhost.
# Docker example: http://192.168.1.50:3001
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# Future dashboard service (optional): http://dashboard:5173
# WEB_DASHBOARD_URL=http://dashboard:5173
