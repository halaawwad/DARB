# Optional base URL for the existing API client; finance has its own connection form.
# Use the computer's LAN IP for physical devices; localhost only works for a browser on this computer.
EXPO_PUBLIC_API_BASE_URL=

# DARB Docker only. Copy this file to .env; never commit .env.
# Use URL-safe letters/digits/underscores for DB/user and hex for the password.
POSTGRES_DB=darb
POSTGRES_USER=darb
POSTGRES_PASSWORD=replace_with_a_random_hex_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,http://localhost:8081,http://127.0.0.1:8081

# Finance connection defaults; never put a password or token in EXPO_PUBLIC variables.
EXPO_PUBLIC_API_URL=http://localhost:3001
# Optional development-only form defaults (not authentication).
EXPO_PUBLIC_FINANCE_COMPANY=
EXPO_PUBLIC_FINANCE_EMAIL=
