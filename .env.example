# Backend base URL (not used yet — every service is mocked).
# Use the computer's LAN IP for physical devices; localhost only works for a browser on this computer.
EXPO_PUBLIC_API_BASE_URL=

# DARB Docker only. Copy this file to .env; never commit .env.
# Use URL-safe letters/digits/underscores for DB/user and hex for the password.
POSTGRES_DB=darb
POSTGRES_USER=darb
POSTGRES_PASSWORD=replace_with_a_random_hex_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
